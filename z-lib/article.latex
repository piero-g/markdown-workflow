\newpage
$elseif(customboxspacing)$
\vspace{$customboxspacing$}
\vspace*{\fill} % push to the bottom
$else$
\vspace{2em} % ia safe spacing if lots of authors
\vspace*{\fill} % push to the bottom
$endif$
\renewenvironment{abstract}
 {\par\noindent\textbf{\abstractname}\ \ignorespaces}
 {\par\medskip}
$for(author)$ % custom: author block with email, orcid and bio
\begin{samepage}
\renewcommand{\abstractname}{$author.name$}
\begin{abstract} % was \sffamily
$if(author.affiliation)$-- $endif$\small $for(author.affiliation)$$author.affiliation$$sep$; $endfor$
$if(author.orcid)$ \\ \aiOrcid~\url{$author.orcid$}$if(author.corresp)$ | {\scriptsize\faEnvelope}~$author.email$$endif$$elseif(author.corresp)$ \\ {\scriptsize\faEnvelope}~$author.email$$endif$$if(author.url)$
 \\ {\scriptsize\faExternalLink}~\url{$author.url$}$endif$$if(author.bio)$
 \\ $author.bio$$endif$ % test 2023 the former block is available in the first page
\end{abstract}
\end{samepage}
$sep$$if(authorsep)$\vspace{$authorsep$}$endif$$endfor$
$endif$
$for(include-after)$
$include-after$

