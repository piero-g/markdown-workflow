\pagestyle{$pagestyle$}
$endif$

$-- Various customizations --$
% custom: suppress numbering in figures and tables, caption centered and small
\usepackage[font=small,justification=centering]{caption}
\captionsetup[figure]{labelformat=empty}
\captionsetup[table]{labelformat=empty}

% custom: better placement for figures
\usepackage[above,section]{placeins}

% custom: icons (and fix for fontawesome)
\usepackage{fontspec}
\defaultfontfeatures{Extension = .otf}
\usepackage{academicons}
\usepackage{fontawesome}
% custom: ORCID color
\definecolor{orcid}{HTML}{A2D03E}

% custom: dates
\usepackage[useregional]{datetime2}

% custom: page number
$if(page.roman)$
\pagenumbering{roman}
$else$
  $if(page.romanup)$
\pagenumbering{Roman}
  $endif$
$endif$
$if(page.startpdf)$
% if pages are in roman we still need an arabic start page for PDF
\setcounter{page}{$page.startpdf$}
$else$
$if(page.start)$
\setcounter{page}{$page.start$}
$endif$
$endif$

% custom: footer and header (except first page)
\usepackage[breakwords]{truncate}
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{} % clear all default
% left header
$if(shorttitle)$
\lhead{\small\sffamily $shorttitle$}
$else$
\lhead{\small\sffamily \truncate{$if(titletruncate)$$titletruncate$$else$9cm$endif$}{$title$}}
$endif$
% right reader
$if(journal.abbrev-title)$
\rhead{\small\sffamily $journal.abbrev-title$$if(issuedisplay)$. $issuedisplay$$endif$}
$else$
\rhead{\small\sffamily $journal.title$$if(issuedisplay)$. $issuedisplay$$endif$}
$endif$
% left footer (DOI)
$if(article.doi)$
\lfoot{\small\sffamily \url{https://doi.org/$article.doi$}}
$else$
\lfoot{\small\sffamily \url{$journal.url$}}
$endif$
% right footer (ID (if issuepagination false) + page (with optional prefix))
\rfoot{\small\sffamily $if(article.id)$$if(issuepagination)$$else$Art.~\#$article.id$ \\ p.$endif$$endif$$if(draft)$\color{red} $else$ $endif$$if(page.prefix)$$page.prefix$$endif$\thepage}
% custom: for more behaved footnotes
\usepackage{etoolbox}
% no superscript footnote marks, by egreg from https://tex.stackexchange.com/a/96400
\makeatletter
\newcommand{\nosupmark@makefnmark}{\@thefnmark}
\pretocmd{\@makefntext}{\let\@makefnmark\nosupmark@makefnmark}{}{}

% custom: footnotes in first page similar to normal ones
%%% By egreg from https://tex.stackexchange.com/a/136750
%%% We don't want to redefine \@makefntext
\patchcmd\maketitle{\@makefntext}{\@@@ddt}{}{}
%%% We don't want to have \rlap around the footnote mark
\patchcmd\maketitle{\rlap}{\mbox}{}{}
\makeatother
$if(safersymbols)$
\DefineFNsymbolsTM{safersymbols}{% def. from https://github.com/FrankMittelbach/fmitex-footmisc/blob/main/footmisc.dtx
  \textasteriskcentered *
  {\textasteriskcentered\textasteriskcentered}{**}%
  {\textasteriskcentered\textasteriskcentered\textasteriskcentered}{***}%
  \textsection   \mathsection
  \textparagraph \mathparagraph
  \textdaggerdbl \ddagger
  \textbardbl    \|%
  \#             \#%
}%
\setfnsymbol{safersymbols}
$elseif(thanksmarkseries)$
% custom: footnotes in first page (thanks) not using fnsymbol (depends on \usepackage{titling})
\thanksmarkseries{$thanksmarkseries$}
$elseif(fnsymbol)$
% custom: different symbols set for thanks (default: lamport*)
\setfnsymbol{$fnsymbol$}
$endif$
$if(issuecolor)$
\definecolor{issuecolor}{HTML}{$issuecolor$}
$endif$
% custom: hideFromPandoc command to allow latex block with \Begin and \End
\newcommand{\hideFromPandoc}[1]{#1}
\hideFromPandoc{
  \let\Begin\begin
  \let\End\end
}
% custom: define \linethickness
\renewcommand{\linethickness}{0.3pt}

% custom: draft mark with date
$if(draft)$
\usepackage[firstpage]{draftwatermark}
\SetWatermarkText{\shortstack{$draft$ \\ {\LARGE\today}}}
$if(linenumbers)$
% custom: in draft mode add line numbers (pagewise, count every 5 lines)
\usepackage[pagewise, modulo]{lineno}
\linenumbers
$endif$
$endif$

% custom: sffont for tables! (if sanstables)
$if(sanstables)$
\AtBeginEnvironment{longtable}{\sffamily}
$endif$

% custom: avoid hyphenation in email!
\usepackage{hyphenat}

% custom: larger space with authors (thanks to titling)
%
$if(institute)$
\preauthor{\begin{center}
  \large
  \def\arraystretch{1.3}%
  \begin{tabular}[t]{c}}
\postauthor{\end{tabular}\par\end{center}
  \begin{center}$if(institutesf)$ \begin{sffamily}$endif$
  {\footnotesize
  \begin{tabular}[t]{c l}
    $for(institute)$
    $if(institute.index)$
    \textsuperscript{$institute.index$} & $institute.name$
    $elseif(institute.name)$ % we assume all authors share the same affiliation
    $institute.name$
    $else$ % we assume there is only one author
    $for(author)$
    $for(author.affiliation)$$author.affiliation$$sep$ \\$endfor$$endfor$
    $endif$$sep$ \\
    $endfor$
  \end{tabular}}
  $if(institutesf)$\end{sffamily} $endif$\end{center}}
$endif$

$if(csl-refs)$
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
\newlength{\cslentryspacingunit} % times entry-spacing
\setlength{\cslentryspacingunit}{\parskip}
\newenvironment{CSLReferences}[2] % #1 hanging-ident, #2 entry spacing
 {% don't indent paragraphs
  \setlength{\parindent}{0pt}
  % turn on hanging indent if param 1 is 1
  \ifodd #1
  \let\oldpar\par
  \def\par{\hangindent=\cslhangindent\oldpar}
  \fi
  % set entry spacing
  \setlength{\parskip}{#2\cslentryspacingunit}
 }%
 {}
\usepackage{calc}
\newcommand{\CSLBlock}[1]{#1\hfill\break}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{#1}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{#1}\break}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$
$if(lang)$
$-- custom: pass langs to the babel package (see below)
\ifLuaTeX
\usepackage[bidi=basic$if(babel-lang)$, main=$babel-lang$$endif$$for(babel-otherlangs)$, $babel-otherlangs$$endfor$]{babel}
\else
\usepackage[bidi=default$if(babel-lang)$, main=$babel-lang$$endif$$for(babel-otherlangs)$, $babel-otherlangs$$endfor$]{babel}
\fi
$-- custom: this part is commented to avoid problems when selecting specific fonts, file per file
$--$if(babel-lang)$
$--\babelprovide[main,import]{$babel-lang$}
$--$if(mainfont)$
$--\ifPDFTeX
$--\else
$--\babelfont[$babel-lang$]{rm}{$mainfont$}
$--\fi
$--$endif$
$--$endif$
$--$for(babel-otherlangs)$
$--\babelprovide[import]{$babel-otherlangs$}
$--$endfor$
% get rid of language-specific shorthands (see #6817):
\let\LanguageShortHands\languageshorthands
\def\languageshorthands#1{}
$endif$
$for(header-includes)$
$header-includes$
$endfor$
\ifLuaTeX
  \usepackage{selnolig}  % disable illegal ligatures
\fi
$if(dir)$
\ifPDFTeX
  \TeXXeTstate=1
  \newcommand{\RL}[1]{\beginR #1\endR}
  \newcommand{\LR}[1]{\beginL #1\endL}
  \newenvironment{RTL}{\beginR}{\endR}
  \newenvironment{LTR}{\beginL}{\endL}
\fi
$endif$
$if(natbib)$
\usepackage[$natbiboptions$]{natbib}
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$plainnat$endif$}
$endif$
$if(biblatex)$
\usepackage[$if(biblio-style)$style=$biblio-style$,$endif$$for(biblatexoptions)$$biblatexoptions$$sep$,$endfor$]{biblatex}
$for(bibliography)$
\addbibresource{$bibliography$}
$endfor$
$endif$
$if(nocite-ids)$
\nocite{$for(nocite-ids)$$it$$sep$, $endfor$}
$endif$
$if(csquotes)$
\usepackage{csquotes}
$endif$
\IfFileExists{bookmark.sty}{\usepackage{bookmark}}{\usepackage{hyperref}}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{} % add URL line breaks if available
\urlstyle{$if(urlstyle)$$urlstyle$$else$same$endif$}
$if(links-as-notes)$
% Make links footnotes instead of hotlinks:
\DeclareRobustCommand{\href}[2]{#2\footnote{\url{#1}}}
$endif$
$if(verbatim-in-note)$
\VerbatimFootnotes % allow verbatim text in footnotes
$endif$
\hypersetup{
$if(title-meta)$
  pdftitle={$title-meta$},
% custom: use title
$elseif(title)$
  pdftitle={$title$},
$endif$
$if(author-meta)$
  pdfauthor={$author-meta$},
% custom: use author list
$elseif(author)$
  pdfauthor={$for(author)$$author.name$$sep$, $endfor$},
$endif$
$if(lang)$
  pdflang={$lang$},
$endif$
$if(subject)$
  pdfsubject={$subject$},
$endif$
$if(keywords)$
  pdfkeywords={$for(keywords)$$keywords$$sep$, $endfor$},
$endif$
$if(colorlinks)$
  colorlinks=true,
  linkcolor={$if(linkcolor)$$linkcolor$$else$Maroon$endif$},
  filecolor={$if(filecolor)$$filecolor$$else$Maroon$endif$},
  citecolor={$if(citecolor)$$citecolor$$else$Blue$endif$},
  urlcolor={$if(urlcolor)$$urlcolor$$else$Blue$endif$},
$else$
$if(boxlinks)$
$else$
  hidelinks,
$endif$
$endif$
  pdfcreator={LaTeX via pandoc}}

$-- Custom Title Page --$
$if(title)$
\title{$if(blocktitle)$$blocktitle$$else$$title$$endif$$for(thanks)$\thanks{$thanks$}$sep$~~~$endfor$$if(correction)$$if(correction.notice)$$else$$if(thanks)$~~~$endif$\thanks{$correction.text$}$endif$$endif$$if(subtitle)$\\[0.3em]$endif$}
$-- custom: after the \thanks and before the closing braket there was: $if(subtitle)$\\[0.3em]\large{}$subtitle$$endif$
$endif$
$if(subtitle)$
$if(beamer)$
$else$
\usepackage{etoolbox}
\makeatletter
\providecommand{\subtitle}[1]{% add subtitle to \maketitle
  \apptocmd{\@title}{\par {\large #1 \par}}{}{}
}
\makeatother
$endif$
\subtitle{$subtitle$}
$endif$
% custom: institute table in title page
$if(author)$ % affiliation only if "affiliationonly" is true, else boxed version below abstract
$if(institute)$ % derived from https://github.com/pandoc-scholar
\author{$for(author)$$author.name$$if(author.corresp)$\thanks{\raggedright\nohyphens{{\scriptsize\faEnvelope}~$author.email$}}$endif$$if(author.orcid)$\textsuperscript{\href{$author.orcid$}{\color{orcid}{\aiOrcid}}}$endif$$if(author.institute_id)$\textsuperscript{\thinspace $for(author.institute_id)$$author.institute_id$$sep$,~$endfor$}$endif$$sep$ \and $endfor$}
$else$
\author{$for(author)$$author.name$$if(affiliationonly)$$if(author.affiliation)$\thanks{\raggedright $for(author.affiliation)$$author.affiliation$$sep$; $endfor$$if(author.corresp)$; \nohyphens{{\scriptsize\faEnvelope}~$author.email$}$endif$$if(author.orcid)$; \aiOrcid~\url{$author.orcid$}$endif$$if(author.note)$ \\ $for(author.note)$$author.note$$sep$ \\ $endfor$$endif$}$elseif(author.corresp)$\thanks{{\scriptsize\faEnvelope}~$author.email$$if(author.orcid)$; \aiOrcid~\url{$author.orcid$}$endif$$if(author.note)$ \\ $for(author.note)$$author.note$$sep$ \\ $endfor$$endif$}$elseif(author.note)$\thanks{$for(author.note)$$author.note$$sep$ \\ $endfor$}$endif$$endif$$sep$ \and $endfor$}
$endif$
$endif$

% custom: dates
$if(date)$ % normal publication date (simple text)
\date{\normalsize $date$}
$else$
$if(dates)$ % submitted, revised, accepted, published dates, in YYYY-MM-DD
\date{\small $if(dates.submitted)$$localization.submitted$: \DTMdate{$dates.submitted$}$if(dates.accepted)$ – $else$$if(dates.published)$ – $endif$$endif$$endif$$if(dates.revised)$$localization.revised$: $for(dates.revised)$\DTMdate{$dates.revised$}$sep$; $endfor$ \\ $endif$$if(dates.accepted)$$localization.accepted$: \DTMdate{$dates.accepted$}$if(dates.published)$ – $endif$$endif$$if(dates.published)$$localization.published$: $if(draft)$\color{red} $endif$\DTMdate{$dates.published$}$endif$}
$endif$
$endif$ % end custom dates

$-- custom: spacing for thanks (firstpage) --$
\setlength{\thanksmarkwidth}{1.8em}
\thanksfootextra{}{\hspace{5pt}}

$-- custom: hyphenation rules [obsolete] (cfr. https://ctan.mirror.garr.it/mirrors/ctan/macros/latex/required/babel/base/babel.pdf p.36) --$
$if(hyphenation)$
\newcommand{\sethyphenation}[2]{%
  \AtBeginDocument{%
    \begin{otherlanguage*}{#1}\hyphenation{#2}\end{otherlanguage*}%
  }%
}
$-- \sethyphenation{$hyphenation.lang$}{$hyphenation.word$}$sep$ --$
$for(hyphenation)$ % was sethyphenation / babelhyphenation
\babelhyphenation[$hyphenation.lang$]{$hyphenation.word$}$sep$

$endfor$
$endif$

$if(beamer)$
$if(institute)$
\institute{$for(institute)$$institute$$sep$ \and $endfor$}
$endif$
$if(titlegraphic)$
\titlegraphic{\includegraphics{$titlegraphic$}}
$endif$
$if(logo)$
\logo{\includegraphics{$logo$}}
$endif$
$endif$

\begin{document}
$if(has-frontmatter)$
\frontmatter
$endif$
$if(title)$
$if(beamer)$
\frame{\titlepage}
$else$
\maketitle
$-- custom: first page header and footer --$
\fancypagestyle{plain}{%
  \fancyhf{}%
  % right header: journal title (extended) and eISSN (up to 4 rows: 1. journal.title+issuedisplay + 2. [opt] issuetitle + 3. issn + 4. [opt] journal.url)
  % TODO: align with HTML (add pagination)
  \rhead{\small\sffamily $journal.title$$if(issuedisplay)$. $issuedisplay$$if(issuetitle)$ \\ $issuetitle$$endif$$endif$$if(journal.eissn)$ \\ ISSN~$journal.eissn$$endif$$if(extrarowheader)$ \\ \url{$journal.url$}$elseif(editor)$ \\ \url{$journal.url$}$endif$}
  % left header: section, peer-reviewed plus DOI or journal url
  $if(article.section)$
  \lhead{\small\sffamily $article.section$$if(article.peer-review)$ -- \emph{$localization.peer-reviewed$}$endif$
  $if(editor)$ \\ $editor.text$$endif$$if(article.doi)$ \\ \url{https://doi.org/$article.doi$}$else$ \\ \url{$journal.url$}$endif$}
  $else$
  $if(article.doi)$\lhead{\small\sffamily \url{$journal.url$} \\ \url{https://doi.org/$article.doi$}}$endif$
  $endif$
  % right footer (ID + page (with optional prefix))
  \rfoot{\small\sffamily $if(issuepagination)$$else$$if(article.id)$Art.~\#$article.id$ \\ p.$endif$$endif$$if(draft)$\color{red} $else$ $endif$$if(page.prefix)$$page.prefix$$endif$\thepage}
  $if(copyright)$
  % left footer: copyright block
  \lfoot{\small\sffamily Copyright \copyright~$if(copyright.year)$$copyright.year$$endif$ $if(copyright.holder)$$copyright.holder$$endif$ \\ $if(copyright.text)$$copyright.text$ \\$endif$ $if(copyright.link)$\url{$copyright.link$}$endif$}
  $endif$
}
$endif$
$if(abstract)$ % custom: abstract name and style
% custom if othertitle:
$if(othertitle)$
\renewcommand{\abstractname}{\vspace{-\baselineskip}}$else$
$if(localization.abstract)$\renewcommand{\abstractname}{$localization.abstract$}$endif$$endif$
\begin{abstract}
$if(othertitle)$\par\noindent\textbf{$othertitle$}\medskip$endif$
$for(abstract)$
$if(indent)$\par\noindent $else$\setlength{\parindent}{0pt}
\par\noindent $endif$$abstract$
$sep$\begin{center}\vspace{-.5em}\rule{0.5\linewidth}{\linethickness}\end{center}$endfor$
% custom: keywords in abstract
$if(keywords)$\vspace{1mm}\\ \textbf{$localization.keywords$}: $for(keywords)$$keywords$$sep$; $endfor$.$endif$
\end{abstract}
$endif$
$if(acknowledgements)$ % custom: acknowledgements
\vspace{$if(ackspace)$$ackspace$$else$1.5em$endif$}
\renewcommand{\abstractname}{$localization.acknowledgements$}
\begin{abstract}
$if(indent)$\par\noindent $else$\setlength{\parindent}{0pt}
\par\noindent $endif$$acknowledgements$
\end{abstract}
$endif$
$if(affiliationonly)$
% custom: no author blocks, just affiliation
$else$
% custom: author blocks
$if(authorspagebreak)$ % custom: put authors in a second page
\newpage
$else$
\vspace{2em} % ia safe spacing if lots of authors
\vspace*{\fill} % push to the bottom
$endif$
\renewenvironment{abstract}
 {\par\noindent\textbf{\abstractname}\ \ignorespaces}
 {\par\medskip}
$for(author)$ % custom: author block with email, orcid and bio
\begin{samepage}
\renewcommand{\abstractname}{$author.name$$if(author.affiliation)$:$endif$}
\begin{abstract} % was \sffamily
\small $for(author.affiliation)$$author.affiliation$$sep$; $endfor$
$if(author.orcid)$ \\ \aiOrcid~\url{$author.orcid$}$endif$$if(author.corresp)$\\ {\scriptsize\faEnvelope}~$author.email$$if(author.url)$;  {\scriptsize\faExternalLink}~\url{$author.url$}$endif$$else$$if(author.url)$\\ {\scriptsize\faExternalLink}~\url{$author.url$}$endif$$endif$$if(author.bio)$ \\ $author.bio$$endif$
\end{abstract}
\end{samepage}
$endfor$
$endif$
$endif$ % if(title)

$for(include-before)$
$include-before$

$endfor$
$if(nopdftoc)$ % custom: to opt-out to toc in pdf
$elseif(toc)$
$if(toc-title)$
\renewcommand*\contentsname{$toc-title$}
$endif$
$if(beamer)$
\begin{frame}[allowframebreaks]
$if(toc-title)$
  \frametitle{$toc-title$}
$endif$
  \tableofcontents[hideallsubsections]
\end{frame}
$else$
{
$if(colorlinks)$
\hypersetup{linkcolor=$if(toccolor)$$toccolor$$else$$endif$}
$endif$
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
}
$endif$
$if(lof)$
\listoffigures
$endif$
$if(lot)$
\listoftables
$endif$
$endif$ % custom: - end if(nopdftoc)
$if(linestretch)$
\setstretch{$linestretch$}
$endif$
$if(has-frontmatter)$
\mainmatter
$endif$
% custom: space from title or separate title page
$if(notitlepage)$
$if(titlepagespace)$
\vspace{$titlepagespace$}
$else$
\vspace{5cm}
$endif$
$else$
\newpage
$endif$
% custom: fnmark with full point
% it's here to avoid breaking \thanks
\makeatletter
\renewcommand{\nosupmark@makefnmark}{\@thefnmark.}
\makeatother
$body$

$if(has-frontmatter)$
\backmatter
$endif$
$if(natbib)$
$if(bibliography)$
$if(biblio-title)$
